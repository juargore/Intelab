<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="RtlSymmetry"
    tools:context=".presentation.ui.home.register.fragment.PreviousJobInformationFragment">

    <data>
        <import type="com.intelab.joblab.R" />
        <variable
            name="viewModel"
            type="com.intelab.joblab.presentation.ui.home.register.viewmodels.PreviousJobInformationViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/layHeader"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@color/green_300"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_job_references"
                android:textColor="@color/black_800"
                android:textSize="20sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/sv_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/bn_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layHeader">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="36dp">

                <include
                    android:id="@+id/header_progress_registration"
                    layout="@layout/header_progress_registration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:advance="@{ viewModel.advance }"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/et_company_name"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="-11.14dp"
                    android:background="@drawable/et_shape_register_rectangle"
                    android:hint="@string/et_company_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="15dp"
                    android:paddingEnd="5dp"
                    android:text="@={viewModel.companyName}"
                    android:textColorHint="@color/black_800"
                    android:textSize="16sp"
                    app:alphabetic="@{true}"
                    app:layout_constraintBottom_toBottomOf="@id/tv_company_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tv_company_name"
                    app:layout_constraintTop_toBottomOf="@id/header_progress_registration"
                    app:layout_constraintTop_toTopOf="@id/tv_company_name"
                    app:maxLength="@{80}" />

                <TextView
                    android:id="@+id/tv_company_name"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="15dp"
                    android:text="@string/tv_company_name"
                    android:textColor="@android:color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/header_progress_registration"
                    app:parallelogramBackground="@{R.color.gray_600}"
                    tools:background="@drawable/vw_shape_parallelogram" />

                <EditText
                    android:id="@+id/et_position_name_hint"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="-11.14dp"
                    android:background="@drawable/et_shape_register_rectangle"
                    android:hint="@string/et_position_name_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:paddingHorizontal="15dp"
                    android:text="@={viewModel.jobName}"
                    android:textColorHint="@color/black_800"
                    android:textSize="16sp"
                    app:alphabetic="@{true}"
                    app:layout_constraintBottom_toBottomOf="@id/tv_position_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tv_position_name"
                    app:layout_constraintTop_toTopOf="@id/tv_position_name"
                    app:maxLength="@{80}" />

                <TextView
                    android:id="@+id/tv_position_name"
                    android:layout_width="110dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="15dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="15dp"
                    android:text="@string/tv_position_name"
                    android:textColor="@android:color/white"
                    app:layout_constraintStart_toStartOf="@id/tv_company_name"
                    app:layout_constraintTop_toBottomOf="@id/tv_company_name"
                    app:parallelogramBackground="@{R.color.gray_600}"
                    tools:background="@drawable/vw_shape_parallelogram" />

                <TextView
                    android:id="@+id/tv_current_job"
                    android:layout_width="200dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="15dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="15dp"
                    android:text="@string/tv_question_current_job"
                    android:textColor="@android:color/white"
                    app:layout_constraintStart_toStartOf="@id/tv_company_name"
                    app:layout_constraintTop_toBottomOf="@id/tv_position_name"
                    app:parallelogramBackground="@{R.color.gray_600}"
                    tools:background="@drawable/vw_shape_parallelogram" />

                <androidx.appcompat.widget.SwitchCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:checked="@={viewModel.currentJobChecked}"
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:textOff="@string/tv_no"
                    android:textOn="@string/tv_yes"
                    app:layout_constraintBottom_toBottomOf="@id/tv_current_job"
                    app:layout_constraintStart_toEndOf="@id/tv_current_job"
                    app:layout_constraintTop_toTopOf="@id/tv_current_job"
                    app:showText="true"
                    app:switchMinWidth="40dp"
                    app:thumbTint="@color/gray_100"
                    app:trackTint="@color/green_300"
                    tools:checked="false" />

                <HorizontalScrollView
                    android:id="@+id/hsv_date"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="15dp"
                    android:fillViewport="true"
                    android:foregroundGravity="center_vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_company_name"
                    app:layout_constraintTop_toBottomOf="@id/tv_current_job">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp">

                        <EditText
                            android:id="@+id/et_since_date"
                            android:layout_width="100dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="-11.14dp"
                            android:background="@color/gray_100"
                            android:focusable="false"
                            android:gravity="center_vertical"
                            android:hint="@string/et_since_date_hint"
                            android:importantForAutofill="no"
                            android:maxLines="1"
                            android:onClick="@{() -> viewModel.onInitialJobDateClicked()}"
                            android:paddingStart="15dp"
                            android:paddingEnd="5dp"
                            android:text="@={viewModel.jobStart}"
                            android:textColorHint="@color/black_800"
                            android:textSize="16sp"
                            app:layout_constraintBottom_toBottomOf="@id/tv_since_date"
                            app:layout_constraintStart_toEndOf="@id/tv_since_date"
                            app:layout_constraintTop_toTopOf="@id/tv_since_date"
                            tools:ignore="TextFields" />

                        <TextView
                            android:id="@+id/tv_since_date"
                            android:layout_width="90dp"
                            android:layout_height="40dp"
                            android:gravity="start|center_vertical"
                            android:paddingStart="15dp"
                            android:text="@string/tv_since_date"
                            android:textColor="@android:color/white"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:parallelogramBackground="@{R.color.gray_600}"
                            tools:background="@drawable/vw_shape_parallelogram" />

                        <EditText
                            android:id="@+id/et_until_date"
                            android:layout_width="150dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="-11.14dp"
                            android:background="@color/gray_100"
                            android:focusable="false"
                            android:gravity="center_vertical"
                            android:hint="@string/et_since_date_hint"
                            android:importantForAutofill="no"
                            android:inputType="date"
                            android:maxLines="1"
                            android:onClick="@{() -> viewModel.onEndJobDateClicked()}"
                            android:paddingStart="15dp"
                            android:paddingEnd="5dp"
                            android:text="@={viewModel.jobEnd}"
                            android:textColorHint="@color/black_800"
                            android:textSize="16sp"
                            app:layout_constraintBottom_toBottomOf="@id/tv_since_date"
                            app:layout_constraintStart_toEndOf="@id/tv_until_date"
                            app:layout_constraintTop_toTopOf="@id/tv_since_date" />

                        <TextView
                            android:id="@+id/tv_until_date"
                            android:layout_width="85dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="-11.14dp"
                            android:gravity="start|center_vertical"
                            android:paddingStart="15dp"
                            android:text="@string/tv_until_date"
                            android:textColor="@android:color/white"
                            app:layout_constraintStart_toEndOf="@id/et_since_date"
                            app:layout_constraintTop_toTopOf="parent"
                            app:parallelogramBackground="@{R.color.gray_600}"
                            tools:background="@drawable/vw_shape_parallelogram" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </HorizontalScrollView>

                <View
                    android:layout_width="11.14dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="15dp"
                    android:background="@color/red_600"
                    app:layout_constraintStart_toStartOf="@id/tv_company_name"
                    app:layout_constraintTop_toBottomOf="@id/tv_position_name"
                    app:triangleBackground="@{R.color.white}"
                    tools:background="@drawable/vw_shape_trapeze" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ct_last_boss"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_company_name"
                    app:layout_constraintTop_toBottomOf="@id/hsv_date">

                    <EditText
                        android:id="@+id/et_last_boss_name"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="-11.14dp"
                        android:background="@color/gray_100"
                        android:hint="@string/et_last_boss_name_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords"
                        android:maxLines="1"
                        android:paddingStart="15dp"
                        android:paddingEnd="5dp"
                        android:text="@={viewModel.lastBossName}"
                        android:textColorHint="@color/black_800"
                        android:textSize="16sp"
                        app:alphabetic="@{true}"
                        app:layout_constraintBottom_toBottomOf="@id/tv_last_boss_name"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_last_boss_name"
                        app:layout_constraintTop_toTopOf="@id/tv_last_boss_name"
                        app:maxLength="@{256}" />

                    <TextView
                        android:id="@+id/tv_last_boss_name"
                        android:layout_width="170dp"
                        android:layout_height="40dp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="15dp"
                        android:text="@string/tv_last_boss_name"
                        android:textColor="@android:color/white"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:parallelogramBackground="@{R.color.gray_600}"
                        tools:background="@drawable/vw_shape_parallelogram" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_contact_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_company_name"
                    app:layout_constraintTop_toBottomOf="@id/ct_last_boss">

                    <EditText
                        android:id="@+id/et_contact_info_email"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="-11.14dp"
                        android:background="@color/gray_100"
                        android:hint="@string/et_contact_info_email_hint"
                        android:importantForAutofill="no"
                        android:inputType="textEmailAddress"
                        android:paddingStart="15dp"
                        android:text="@={viewModel.contactEmail}"
                        android:textColorHint="@color/black_800"
                        android:textSize="16sp"
                        app:errorMessage="@{viewModel.errorMessage}"
                        app:layout_constraintBottom_toBottomOf="@id/tv_contact_info"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_contact_info"
                        app:layout_constraintTop_toTopOf="@id/tv_contact_info"
                        app:validateEmailFormat="@{true}" />

                    <TextView
                        android:id="@+id/tv_contact_info"
                        android:layout_width="160dp"
                        android:layout_height="40dp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="15dp"
                        android:text="@string/tv_contact_info"
                        android:textColor="@android:color/white"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:parallelogramBackground="@{R.color.gray_600}"
                        tools:background="@drawable/vw_shape_parallelogram" />

                    <EditText
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="13.92dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/red_600"
                        android:hint="@string/et_contact_info_phone_hint"
                        android:inputType="phone"
                        android:paddingStart="15dp"
                        android:paddingEnd="5dp"
                        android:text="@={viewModel.contactPhone}"
                        android:textColorHint="@color/black_800"
                        android:textSize="16sp"
                        app:errorMessage="@{viewModel.errorMessagePhone}"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/et_contact_info_email"
                        app:layout_constraintTop_toBottomOf="@id/tv_contact_info"
                        app:maxFieldLength="@{25}"
                        app:trapezeBackground="@{R.color.gray_100}"
                        tools:background="@drawable/vw_shape_trapeze"
                        tools:ignore="Autofill" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <Button
            android:id="@+id/bn_back"
            android:layout_width="130dp"
            android:layout_height="30dp"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:onClick="@{() -> viewModel.onCancelClicked()}"
            android:padding="1dp"
            android:text="@string/bn_text_cancel"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="19sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bn_next"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:parallelogramBackground="@{R.color.gray_600}"
            tools:background="@drawable/vw_shape_parallelogram" />

        <Button
            android:id="@+id/bn_next"
            android:layout_width="130dp"
            android:layout_height="30dp"
            android:layout_marginBottom="40dp"
            android:background="@{viewModel.nextBnEnabled ? R.color.green_300 : R.color.gray_300}"
            android:enabled="@{viewModel.nextBnEnabled}"
            android:gravity="center"
            android:onClick="@{() -> viewModel.onSaveClicked() }"
            android:padding="1dp"
            android:text="@string/bn_text_save"
            android:textAllCaps="false"
            android:textColor="@{viewModel.nextBnEnabled ? R.color.gray_800 : R.color.gray_500}"
            android:textSize="19sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/bn_back"
            tools:background="@drawable/vw_shape_parallelogram" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
