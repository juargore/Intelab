<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".presentation.ui.home.register.fragment.AcademicFragment">

    <data>
        <import type="com.intelab.joblab.R" />
        <variable
            name="viewModel"
            type="com.intelab.joblab.presentation.ui.home.profile.viewmodels.ProfileSocialMediaViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/header"
            layout="@layout/header_generic_joblab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:userName="@{ viewModel.userFullName }"
            app:screenTitle="@{ R.string.tv_title_profile_edition }"
            app:showCounter="@{ true }"
            app:counter="@{ viewModel.counterScreen }"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:id="@+id/sv_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/linearLayout3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/tv_social_media"
                    android:textColor="@color/black_800"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <CheckBox
                    android:id="@+id/cb_social_network"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:buttonTint="@color/green_300"
                    android:checked="@={viewModel.selectedNoSocialNetwork}"
                    android:gravity="center"
                    android:padding="10dp"
                    android:scaleX="1.50"
                    android:scaleY="1.50"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_title" />

                <TextView
                    android:id="@+id/tv_not_social_media"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="5dp"
                    android:text="@string/tv_not_social_media"
                    android:textColor="@android:color/white"
                    app:layout_constraintBottom_toBottomOf="@id/cb_social_network"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cb_social_network"
                    app:trapezeBackground="@{R.color.gray_600}"
                    tools:background="@drawable/vw_shape_trapeze" />

                <TextView
                    android:id="@+id/tv_social_media"
                    android:layout_width="150dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="5dp"
                    android:text="@string/tv_social_media"
                    android:textColor="@android:color/white"
                    app:layout_constraintStart_toStartOf="@id/cb_social_network"
                    app:layout_constraintTop_toBottomOf="@id/tv_not_social_media"
                    app:parallelogramBackground="@{R.color.gray_600}"
                    tools:background="@drawable/vw_shape_parallelogram" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/hv_social_media"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fillViewport="true"
                    android:paddingStart="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_social_media"
                    tools:ignore="RtlSymmetry">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_facebook"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_facebook" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_facebook"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:enabled="@{!viewModel.selectedNoSocialNetwork}"
                        android:hint="@string/et_facebook_hint"
                        android:importantForAutofill="no"
                        android:inputType="textWebEmailAddress"
                        android:paddingStart="15dp"
                        android:paddingEnd="5dp"
                        android:text="@={viewModel.facebook.username}"
                        android:textColorHint="@color/black_800"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_facebook"
                        app:layout_constraintTop_toTopOf="parent"
                        app:trapezeBackground="@{R.color.gray_100}"
                        tools:background="@drawable/vw_shape_trapeze" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_instagram"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        app:layout_constraintStart_toStartOf="@id/iv_facebook"
                        app:layout_constraintTop_toBottomOf="@id/iv_facebook"
                        app:srcCompat="@drawable/ic_instagram" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_instagram"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        android:enabled="@{!viewModel.selectedNoSocialNetwork}"
                        android:hint="@string/et_facebook_hint"
                        android:importantForAutofill="no"
                        android:inputType="textWebEmailAddress"
                        android:paddingStart="15dp"
                        android:paddingEnd="5dp"
                        android:text="@={viewModel.instagram.username}"
                        android:textColorHint="@color/black_800"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_facebook"
                        app:layout_constraintTop_toBottomOf="@id/et_facebook"
                        app:trapezeBackground="@{R.color.gray_100}"
                        tools:background="@drawable/vw_shape_trapeze" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_twitter"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        app:layout_constraintStart_toStartOf="@id/iv_facebook"
                        app:layout_constraintTop_toBottomOf="@id/iv_instagram"
                        app:srcCompat="@drawable/ic_twitter" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_twitter"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        android:enabled="@{!viewModel.selectedNoSocialNetwork}"
                        android:hint="@string/et_facebook_hint"
                        android:importantForAutofill="no"
                        android:inputType="textWebEmailAddress"
                        android:paddingStart="15dp"
                        android:paddingEnd="5dp"
                        android:text="@={viewModel.twitter.username}"
                        android:textColorHint="@color/black_800"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_facebook"
                        app:layout_constraintTop_toBottomOf="@id/et_instagram"
                        app:trapezeBackground="@{R.color.gray_100}"
                        tools:background="@drawable/vw_shape_trapeze" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_linkedin"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        app:layout_constraintStart_toStartOf="@id/iv_facebook"
                        app:layout_constraintTop_toBottomOf="@id/iv_twitter"
                        app:srcCompat="@drawable/ic_linkedin" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_linkedin"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        android:enabled="@{!viewModel.selectedNoSocialNetwork}"
                        android:hint="@string/et_facebook_hint"
                        android:importantForAutofill="no"
                        android:inputType="textWebEmailAddress"
                        android:paddingStart="15dp"
                        android:paddingEnd="5dp"
                        android:text="@={viewModel.linkedin.username}"
                        android:textColorHint="@color/black_800"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_facebook"
                        app:layout_constraintTop_toBottomOf="@id/et_twitter"
                        app:trapezeBackground="@{R.color.gray_100}"
                        tools:background="@drawable/vw_shape_trapeze" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_pinterest"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        app:layout_constraintStart_toStartOf="@id/iv_facebook"
                        app:layout_constraintTop_toBottomOf="@id/iv_linkedin"
                        app:srcCompat="@drawable/ic_pinterest" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_pinterest"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        android:enabled="@{!viewModel.selectedNoSocialNetwork}"
                        android:hint="@string/et_facebook_hint"
                        android:importantForAutofill="no"
                        android:inputType="textWebEmailAddress"
                        android:paddingStart="15dp"
                        android:paddingEnd="5dp"
                        android:text="@={viewModel.pinterest.username}"
                        android:textColorHint="@color/black_800"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_facebook"
                        app:layout_constraintTop_toBottomOf="@id/et_linkedin"
                        app:trapezeBackground="@{R.color.gray_100}"
                        tools:background="@drawable/vw_shape_trapeze" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_youtube"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        app:layout_constraintStart_toStartOf="@id/iv_facebook"
                        app:layout_constraintTop_toBottomOf="@id/iv_pinterest"
                        app:srcCompat="@drawable/ic_youtube" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_youtube"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        android:enabled="@{!viewModel.selectedNoSocialNetwork}"
                        android:hint="@string/et_facebook_hint"
                        android:importantForAutofill="no"
                        android:inputType="textWebEmailAddress"
                        android:paddingStart="15dp"
                        android:paddingEnd="5dp"
                        android:text="@={viewModel.youtube.username}"
                        android:textColorHint="@color/black_800"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_facebook"
                        app:layout_constraintTop_toBottomOf="@id/et_pinterest"
                        app:trapezeBackground="@{R.color.gray_100}"
                        tools:background="@drawable/vw_shape_trapeze" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/et_other"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="5dp"
                        android:enabled="@{!viewModel.selectedNoSocialNetwork}"
                        android:hint="@string/et_other"
                        android:importantForAutofill="no"
                        android:inputType="textWebEmailAddress"
                        android:paddingStart="15dp"
                        android:paddingEnd="5dp"
                        android:text="@={viewModel.other.username}"
                        android:textColorHint="@color/black_800"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_facebook"
                        app:layout_constraintTop_toBottomOf="@id/et_youtube"
                        app:maxFieldLength="@{80}"
                        app:trapezeBackground="@{R.color.gray_100}"
                        tools:background="@drawable/vw_shape_trapeze" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <Button
                android:id="@+id/btnSaveAndExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@null"
                android:onClick="@{ viewModel::onSaveAndExitClicked }"
                android:text="@string/tv_title_save_and_exit"
                android:textAllCaps="false"
                android:textColor="@color/gray_800"
                android:textSize="16sp"
                app:underline="@{ true }"
                tools:ignore="ButtonStyle" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>