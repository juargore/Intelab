<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".presentation.ui.init.forget.fragment.RecoverPasswordFragment">

    <data>

        <import type="com.intelab.joblab.R" />

        <variable
            name="viewModel"
            type="com.intelab.joblab.presentation.ui.init.forget.viewmodels.RecoverPasswordViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/app_toolbar"
            layout="@layout/app_toolbar" />

        <ScrollView
            android:id="@+id/sv_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_toolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp">

                <include
                    android:id="@+id/header_init_register"
                    layout="@layout/header_init_register"
                    app:message="@{@string/tv_recover_password_message}" />

                <TextView
                    android:id="@+id/tv_password_recover_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:text="@string/tv_password_recover_title"
                    android:textColor="@color/black_800"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/header_init_register" />

                <TextView
                    android:id="@+id/tv_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/tv_input_password_label"
                    android:textColor="@color/black_800"
                    app:layout_constraintStart_toStartOf="@id/til_password"
                    app:layout_constraintTop_toBottomOf="@id/tv_password_recover_title" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30dp"
                    android:layout_marginTop="10dp"
                    app:hintEnabled="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_password"
                    app:message="@{viewModel.passwordMessage}"
                    app:passwordToggleEnabled="true">

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:afterTextChanged="@{(text) -> viewModel.passwordAfterTextChanged()}"
                        android:hint="@string/et_new_password_hint"
                        android:inputType="textPassword"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="0dp"
                        android:text="@={viewModel.password}"
                        android:textColorHint="@color/gray_600"
                        app:parallelogramBackground="@{R.color.gray_100}"
                        app:textPassword="@{true}"
                        tools:background="@drawable/vw_shape_parallelogram"
                        tools:ignore="Autofill" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tv_password_confirmation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:text="@string/tv_password_confirmation"
                    android:textColor="@color/black_800"
                    app:layout_constraintStart_toStartOf="@id/til_password_confirmation"
                    app:layout_constraintTop_toBottomOf="@id/til_password" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_password_confirmation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:hintEnabled="false"
                    app:layout_constraintEnd_toEndOf="@id/til_password"
                    app:layout_constraintStart_toStartOf="@id/til_password"
                    app:layout_constraintTop_toBottomOf="@id/tv_password_confirmation"
                    app:message="@{viewModel.passwordConfMessage}"
                    app:passwordToggleEnabled="true">

                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:afterTextChanged="@{(text) -> viewModel.passwordConfirmationAfterTextChanged()}"
                        android:hint="@string/et_new_password_again_hint"
                        android:inputType="textPassword"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="0dp"
                        android:text="@={viewModel.rePassword}"
                        android:textColorHint="@color/gray_600"
                        app:parallelogramBackground="@{R.color.gray_100}"
                        app:textPassword="@{true}"
                        tools:background="@drawable/vw_shape_parallelogram"
                        tools:ignore="Autofill" />

                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/bn_next"
                    android:layout_width="130dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="50dp"
                    android:background="@{ viewModel.nextBnEnabled ? R.color.green_300 : R.color.gray_300 }"
                    android:enabled="@{ viewModel.nextBnEnabled }"
                    android:gravity="center"
                    android:onClick="@{() -> viewModel.onNextClicked()}"
                    android:padding="1dp"
                    android:text="@string/bn_text_next"
                    android:textAllCaps="false"
                    android:textColor="@{ viewModel.nextBnEnabled ? R.color.gray_800 : R.color.gray_500 }"
                    android:textSize="19sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/til_password_confirmation"
                    tools:background="@drawable/vw_shape_parallelogram" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>