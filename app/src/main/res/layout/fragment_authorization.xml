<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".presentation.ui.init.register.fragments.AuthorizationFragment">

    <data>

        <import type="com.intelab.joblab.R" />

        <import type="android.text.Html" />

        <variable
            name="enabled"
            type="Boolean" />

        <variable
            name="viewModel"
            type="com.intelab.joblab.presentation.ui.init.register.viewmodels.AuthorizationViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/app_toolbar"
            layout="@layout/app_toolbar" />

        <ScrollView
            android:id="@+id/sv_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_toolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp">

                <include
                    android:id="@+id/header_init_register"
                    layout="@layout/header_init_register"
                    app:message="@{@string/tv_authorization_message}" />

                <TextView
                    android:id="@+id/tv_consent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/tv_accordance"
                    android:textColor="@color/black_800"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/header_init_register" />

                <TextView
                    android:id="@+id/tv_consent_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/tv_background_consent_description"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="16dp"
                    android:text="@string/tv_consent"
                    android:textColor="@color/black_800"
                    android:textSize="18sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_consent" />

                <CheckBox
                    android:id="@+id/cb_privacy_notice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="40dp"
                    android:buttonTint="@color/green_300"
                    android:checked="@={viewModel.cbPrivacyNotice }"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_consent_description" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="@string/tv_privacy_notice"
                    android:textColorLink="@color/orange_500"
                    app:clickEnd="@{29}"
                    app:clickInit="@{10}"
                    app:layout_constraintStart_toEndOf="@id/cb_privacy_notice"
                    app:layout_constraintTop_toTopOf="@id/cb_privacy_notice"
                    app:onClick="@{viewModel::onPrivacyLinkClicked}" />

                <CheckBox
                    android:id="@+id/cb_consent_accept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="20dp"
                    android:buttonTint="@color/green_300"
                    android:checked="@={viewModel.cbConsentAccept}"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cb_privacy_notice" />

                <TextView
                    android:id="@+id/tv_consent_accept"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="24dp"
                    android:text="@string/tv_consent_accept"
                    android:textColorLink="@color/orange_500"
                    app:clickEnd="@{92}"
                    app:clickInit="@{70}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cb_consent_accept"
                    app:layout_constraintTop_toTopOf="@id/cb_consent_accept"
                    app:onClick="@{viewModel::onConsentLinkClicked}" />

                <Button
                    android:id="@+id/bn_next"
                    android:layout_width="130dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="45dp"
                    android:background="@{viewModel.nextBnState ? R.color.green_300 : R.color.gray_300}"
                    android:enabled="@{viewModel.nextBnState}"
                    android:gravity="center"
                    android:onClick="@{() -> viewModel.onNextClicked() }"
                    android:padding="1dp"
                    android:text="@string/bn_text_next"
                    android:textAllCaps="false"
                    android:textColor="@{viewModel.nextBnState ? R.color.gray_800 : R.color.gray_500}"
                    android:textSize="19sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_consent_accept"
                    tools:background="@drawable/vw_shape_parallelogram" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>


