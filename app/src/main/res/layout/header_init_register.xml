<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.intelab.joblab.R" />

        <variable
            name="message"
            type="String" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".presentation.ui.home.activity.HomeActivity">

        <TextView
            android:id="@+id/tv_message"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:background="@color/gray_600"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="45dp"
            android:text="@{message}"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/vw_trapeze"
            android:layout_width="45dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_message"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_message"
            app:trapezeBackground="@{R.color.white}"
            tools:background="@drawable/vw_shape_trapeze" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>