<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="item"
            type="com.intelab.joblab.presentation.ui.home.accutest.adapter.item.AccutestItem" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardBackgroundColor="@{item.showImage ? @color/white : @color/gray_600}"
            app:cardCornerRadius="7dp"
            app:cardElevation="15dp"
            app:contentPadding="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_content"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_number">

                <TextView
                    android:id="@+id/tv_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="4sp"
                    app:autoSizeMaxTextSize="12sp"
                    app:autoSizeStepGranularity="1sp"
                    android:gravity="center"
                    android:text="@{item.text}"
                    android:textColor="@color/white"
                    android:visibility="@{item.showImage ? View.INVISIBLE : View.VISIBLE }"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Un carro chocado" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:visibility="@{item.showImage ? View.VISIBLE : View.INVISIBLE }"
                    app:url="@{item.imagePath}" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_number"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:background="@drawable/vw_shape_circular_number"
            android:elevation="20dp"
            android:gravity="center"
            android:text="@{String.valueOf(item.position)}"
            android:textColor="@android:color/black"
            android:textSize="11sp"
            app:layout_constraintBottom_toTopOf="@id/cv_test"
            app:layout_constraintEnd_toEndOf="@id/cv_test"
            app:layout_constraintStart_toEndOf="@id/cv_test"
            app:layout_constraintTop_toTopOf="@id/cv_test"
            tools:text="13" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>