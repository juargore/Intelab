<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="RtlSymmetry"
    tools:context=".presentation.ui.home.register.fragment.PersonalInformationPartTwoFragment">

    <data>
        <import type="com.intelab.joblab.R" />
        <import type="android.text.Html" />
        <variable
            name="viewModel"
            type="com.intelab.joblab.presentation.ui.home.register.viewmodels.PersonalInformationPartTwoViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/layHeader"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@color/green_300"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_personal_information"
                android:textColor="@color/black_800"
                android:textSize="20sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/sv_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layHeader">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="36dp">

                <include
                    android:id="@+id/vw_register_header"
                    layout="@layout/header_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-47dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:stepNumber="@{@string/tv_step_one}"
                    app:stringId="@{R.string.tv_input_information_required}"
                    app:text="@{@string/tv_register}" />

                <include
                    android:id="@+id/header_progress_registration"
                    layout="@layout/header_progress_registration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:advance="@{ viewModel.advance }"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/vw_register_header" />

                <fragment
                    android:id="@+id/header_register_photo"
                    android:name="com.intelab.joblab.presentation.ui.helpers.images.ImageGalleryOrCameraFragment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-30dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/header_progress_registration"
                    tools:ignore="FragmentTagUsage"
                    tools:layout="@layout/fragment_image_gallery_or_camera" />

                <TextView
                    android:id="@+id/tv_birthday"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="40dp"
                    android:background="@color/gray_600"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:text="@string/tv_birthday"
                    android:textColor="@android:color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/header_register_photo"
                    app:trapezeBackground="@{R.color.gray_600}"
                    tools:background="@drawable/vw_shape_trapeze" />

                <HorizontalScrollView
                    android:id="@+id/hs_birthday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11.14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_birthday"
                    app:layout_constraintTop_toBottomOf="@id/tv_birthday">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="8dp"
                        tools:ignore="RtlSymmetry">

                        <com.intelab.joblab.presentation.ui.views.CustomSpinner
                            android:id="@+id/sp_year"
                            android:layout_width="120dp"
                            android:layout_height="40dp"
                            android:dropDownWidth="120dp"
                            android:paddingStart="15dp"
                            android:textAllCaps="false"
                            app:entries="@{viewModel.yearsList}"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:parallelogramBackground="@{R.color.gray_100}"
                            app:selectedValue="@={viewModel.selectedYear}"
                            tools:background="@drawable/vw_shape_parallelogram"
                            tools:ignore="RtlSymmetry" />

                        <com.intelab.joblab.presentation.ui.views.CustomSpinner
                            android:id="@+id/sp_month"
                            android:layout_width="110dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="12dp"
                            android:paddingStart="15dp"
                            android:textAllCaps="false"
                            app:entries="@{viewModel.monthsList}"
                            app:layout_constraintBottom_toBottomOf="@id/sp_year"
                            app:layout_constraintStart_toEndOf="@id/sp_year"
                            app:parallelogramBackground="@{R.color.gray_100}"
                            app:selectedValue="@={viewModel.selectedMonth}"
                            tools:background="@drawable/vw_shape_parallelogram" />

                        <com.intelab.joblab.presentation.ui.views.CustomSpinner
                            android:id="@+id/sp_day"
                            android:layout_width="110dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="12dp"
                            android:paddingStart="15dp"
                            android:textAllCaps="false"
                            app:entries="@{viewModel.daysList}"
                            app:layout_constraintBottom_toBottomOf="@id/sp_year"
                            app:layout_constraintStart_toEndOf="@id/sp_month"
                            app:parallelogramBackground="@{R.color.gray_100}"
                            app:selectedValue="@={viewModel.selectedDay}"
                            tools:background="@drawable/vw_shape_parallelogram" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tv_birth_state"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:text="@string/tv_birthday_state"
                    android:textColor="@android:color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_birthday"
                    app:layout_constraintTop_toBottomOf="@id/hs_birthday"
                    app:trapezeBackground="@{R.color.gray_600}"
                    tools:background="@drawable/vw_shape_trapeze" />

                <com.intelab.joblab.presentation.ui.views.CustomSpinner
                    android:id="@+id/sp_birthday_state"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="11.14dp"
                    android:paddingStart="15dp"
                    android:textAllCaps="false"
                    app:entries="@{viewModel.statesList}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_birth_state"
                    app:layout_constraintTop_toBottomOf="@id/tv_birth_state"
                    app:selectedValue="@={viewModel.selectedState}"
                    app:trapezeBackground="@{R.color.gray_100}"
                    tools:background="@drawable/vw_shape_trapeze" />

                <TextView
                    android:id="@+id/tv_gender"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="15dp"
                    android:background="@color/gray_600"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:text="@string/tv_gender"
                    android:textColor="@android:color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_birthday"
                    app:layout_constraintTop_toBottomOf="@id/sp_birthday_state"
                    app:trapezeBackground="@{R.color.gray_600}"
                    tools:background="@drawable/vw_shape_trapeze" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_genders"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:choices="@{viewModel.genders}"
                    app:currentPosition="@={viewModel.genderPosition}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_gender"
                    app:layout_constraintTop_toBottomOf="@id/tv_gender" />

                <TextView
                    android:id="@+id/tv_marital"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:background="@color/gray_600"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:text="@string/tv_marital_status"
                    android:textColor="@android:color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_birthday"
                    app:layout_constraintTop_toBottomOf="@id/rv_genders"
                    app:trapezeBackground="@{R.color.gray_600}"
                    tools:background="@drawable/vw_shape_trapeze" />

                <com.intelab.joblab.presentation.ui.views.CustomSpinner
                    android:id="@+id/sp_marital"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="11.14dp"
                    android:paddingStart="15dp"
                    android:textAllCaps="false"
                    app:entries="@{viewModel.maritals}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_gender"
                    app:layout_constraintTop_toBottomOf="@id/tv_marital"
                    app:selectedValue="@={viewModel.selectedMaritalStatus}"
                    app:trapezeBackground="@{R.color.gray_100}"
                    tools:background="@drawable/vw_shape_trapeze" />

                <TextView
                    android:id="@+id/tv_children"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="15dp"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:text="@string/tv_children"
                    android:textColor="@android:color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_birthday"
                    app:layout_constraintTop_toBottomOf="@id/sp_marital"
                    app:trapezeBackground="@{R.color.gray_600}"
                    tools:background="@drawable/vw_shape_trapeze" />

                <com.intelab.joblab.presentation.ui.views.CustomSpinner
                    android:id="@+id/sp_children"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="11.14dp"
                    android:paddingStart="15dp"
                    android:textAllCaps="false"
                    app:entries="@{viewModel.childrenNumber}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_children"
                    app:layout_constraintTop_toBottomOf="@id/tv_children"
                    app:selectedValue="@={viewModel.selectedChildrenNumber}"
                    app:trapezeBackground="@{R.color.gray_100}"
                    tools:background="@drawable/vw_shape_trapeze" />

                <Button
                    android:id="@+id/bn_back"
                    android:layout_width="130dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="44dp"
                    android:gravity="center"
                    android:onClick="@{() -> viewModel.onBackClicked()}"
                    android:padding="1dp"
                    android:text="@string/bn_back"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="19sp"
                    app:layout_constraintEnd_toStartOf="@+id/bn_next"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/sp_children"
                    app:parallelogramBackground="@{R.color.gray_600}"
                    tools:background="@drawable/vw_shape_parallelogram" />

                <Button
                    android:id="@+id/bn_next"
                    android:layout_width="130dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="44dp"
                    android:background="@{viewModel.nextBnEnabled ? R.color.green_300 : R.color.gray_300}"
                    android:enabled="@{viewModel.nextBnEnabled}"
                    android:gravity="center"
                    android:onClick="@{() -> viewModel.onNextClicked()}"
                    android:padding="1dp"
                    android:text="@string/bn_text_next"
                    android:textAllCaps="false"
                    android:textColor="@{viewModel.nextBnEnabled ? R.color.gray_800 : R.color.gray_500}"
                    android:textSize="19sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/bn_back"
                    app:layout_constraintTop_toBottomOf="@id/sp_children"
                    tools:background="@drawable/vw_shape_parallelogram" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
