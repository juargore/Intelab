<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="kotlin.jvm.functions.Function0" />

        <import type="com.intelab.joblab.R" />

        <import type="kotlin.Unit" />

        <variable
            name="title"
            type="String" />

        <variable
            name="email"
            type="String" />

        <variable
            name="radioChecked"
            type="Integer" />

        <variable
            name="isEnabled"
            type="Boolean" />

        <variable
            name="photo"
            type="String" />

        <variable
            name="photoUri"
            type="android.net.Uri" />

        <variable
            name="action"
            type="Function0&lt;Unit>" />

        <variable
            name="isRadioButtonEnabled"
            type="Boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@{title}"
            android:textColor="@color/black_800"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="PERSONAL" />

        <com.intelab.joblab.presentation.ui.views.CircularCompletionView
            android:id="@+id/ccv_photo"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:onClick="@{() -> action.invoke()}"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_photo_user"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:loadFromUri="@{photoUri}"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
            app:url_no_cache="@{photo != null ? @string/small_size_user_avatar(photo) : null}" />

        <EditText
            android:id="@+id/et_email"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="15dp"
            android:enabled="@{ isEnabled }"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions|textEmailAddress"
            android:maxLines="1"
            android:paddingHorizontal="15.14dp"
            android:text="@{ email }"
            app:layout_constraintBottom_toBottomOf="@id/ccv_photo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ccv_photo"
            app:layout_constraintTop_toTopOf="@id/ccv_photo"
            app:parallelogramBackground="@{R.color.gray_100}"
            tools:background="@drawable/vw_shape_parallelogram" />

        <RadioGroup
            android:id="@+id/radioParent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checkedButton="@={radioChecked}"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/et_email"
            app:layout_constraintStart_toStartOf="@id/et_email"
            app:layout_constraintTop_toBottomOf="@id/et_email">

            <RadioButton
                android:id="@+id/radioNational"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_margin="4dp"
                android:buttonTint="@color/green_300"
                android:clickable="@{ isRadioButtonEnabled, default = false }"
                android:enabled="@{ isRadioButtonEnabled, default = false }"
                android:layoutDirection="rtl"
                android:text="@string/tv_national"
                android:textAlignment="textStart"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/radioForeign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_margin="4dp"
                android:buttonTint="@color/green_300"
                android:clickable="@{ isRadioButtonEnabled, default = false }"
                android:enabled="@{ isRadioButtonEnabled, default = false }"
                android:layoutDirection="rtl"
                android:text="@string/tv_foreign"
                android:textAlignment="textStart"
                android:textSize="14sp" />

        </RadioGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
