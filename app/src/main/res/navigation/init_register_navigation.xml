<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/init_register_navigation"
    app:startDestination="@id/createAccountFragment">
    <fragment
        android:id="@+id/createAccountFragment"
        android:name="com.intelab.joblab.presentation.ui.init.register.fragments.CreateAccountFragment"
        android:label="fragment_create_account"
        tools:layout="@layout/fragment_create_account">
        <action
            android:id="@+id/action_createAccountFragment_to_activateAccountFragment"
            app:destination="@id/activateAccountFragment" />
    </fragment>
    <fragment
        android:id="@+id/activateAccountFragment"
        android:name="com.intelab.joblab.presentation.ui.init.register.fragments.ActivateAccountFragment"
        android:label="fragment_activate_account"
        tools:layout="@layout/fragment_activate_account">
        <action
            android:id="@+id/action_activateAccountFragment_to_authorizationFragment"
            app:destination="@id/authorizationFragment" />
        <deepLink app:uri="joblab://activate-account" />
    </fragment>
    <fragment
        android:id="@+id/authorizationFragment"
        android:name="com.intelab.joblab.presentation.ui.init.register.fragments.AuthorizationFragment"
        android:label="fragment_authorization"
        tools:layout="@layout/fragment_authorization">
        <action
            android:id="@+id/action_authorizationFragment_to_personalInformationFragment"
            app:destination="@id/personalInformationFragment" />
        <action
            android:id="@+id/action_authorizationFragment_to_privacityAndConsentFragment"
            app:destination="@id/privacityAndConsentFragment" />
        <deepLink app:uri="joblab://init-register-authorization" />
    </fragment>
    <fragment
        android:id="@+id/personalInformationFragment"
        android:name="com.intelab.joblab.presentation.ui.init.register.fragments.PersonalInformationFragment"
        android:label="PersonalInformationFragment"
        tools:layout="@layout/fragment_personal_information">
        <action
            android:id="@+id/action_personalInformationValidateFragment_to_postulationFragment"
            app:destination="@id/postulationFragment" />
    </fragment>
    <fragment
        android:id="@+id/postulationFragment"
        android:name="com.intelab.joblab.presentation.ui.init.register.fragments.PostulationFragment"
        android:label="fragment_postulation"
        tools:layout="@layout/fragment_postulation">
        <action
            android:id="@+id/action_postulationFragment_to_personalInformationValidateFragment"
            app:destination="@id/personalInformationValidateFragment" />
    </fragment>
    <fragment
        android:id="@+id/personalInformationValidateFragment"
        android:name="com.intelab.joblab.presentation.ui.init.register.fragments.PersonalInformationValidateFragment"
        android:label="PersonalInformationValidateFragment"
        tools:layout="@layout/fragment_personal_information_validate">
        <action
            android:id="@+id/action_personalInformationValidateFragment_to_personalInformationFragment"
            app:destination="@id/personalInformationFragment"
            app:popUpTo="@id/personalInformationFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.intelab.joblab.presentation.ui.init.register.fragments.CameraFragment"
        android:label="fragment_camera"
        tools:layout="@layout/fragment_camera" />
    <fragment
        android:id="@+id/privacityAndConsentFragment"
        android:name="com.intelab.joblab.presentation.ui.init.register.fragments.PrivacyAndConsentFragment"
        android:label="fragment_privacity_and_consent"
        tools:layout="@layout/fragment_privacy_and_consent">

        <argument
            android:name="type"
            android:defaultValue="0"
            app:argType="integer" />

    </fragment>

</navigation>