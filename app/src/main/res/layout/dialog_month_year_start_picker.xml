<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.intelab.joblab.presentation.ui.home.register.viewmodels.PreviousJobInformationViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <NumberPicker
            android:id="@+id/pickerYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:value="@={viewModel.pickedStartedYear}"
            app:maxValue="@{viewModel.currentYear}"
            app:minValue="@{1960}" />

        <NumberPicker
            android:id="@+id/pickerMonth"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:value="@={viewModel.pickedStartedMonth}"
            app:displayedValues="@{viewModel.displayStartedMonthValues}"
            app:maxValue="@{viewModel.maxStartedMonth}"
            app:minValue="@{viewModel.minStartedMonth}" />

    </LinearLayout>
</layout>