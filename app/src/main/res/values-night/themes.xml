<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Joblab" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:fontFamily">@font/app_font</item>
    </style>

    <style name="JoblabDialogStyle" parent="android:Theme.Material.Dialog">
        <item name="android:dialogCornerRadius" tools:ignore="NewApi">16dp</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="JoblabProgressDialogStyle" parent="Theme.AppCompat.Dialog">
        <item name="android:backgroundDimAmount">0.8</item>
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
    </style>

</resources>