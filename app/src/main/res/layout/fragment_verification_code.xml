<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".presentation.ui.init.forget.fragment.VerificationCodeFragment">

    <data>

        <import type="com.intelab.joblab.R" />

        <variable
            name="viewModel"
            type="com.intelab.joblab.presentation.ui.init.forget.viewmodels.VerificationCodeViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/app_toolbar"
            layout="@layout/app_toolbar" />

        <ScrollView
            android:id="@+id/sv_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_toolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp">

                <include
                    android:id="@+id/header_init_register"
                    layout="@layout/header_init_register"
                    app:message="@{@string/tv_check_inbox_message}" />

                <TextView
                    android:id="@+id/tv_password_recover_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="50dp"
                    android:text="@string/tv_password_recover_title"
                    android:textColor="@color/black_800"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/header_init_register" />

                <TextView
                    android:id="@+id/tv_password_recover_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@{String.format(@string/tv_password_recover_subtitle, viewModel.maskEmail)}"
                    android:textColor="@color/black_800"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_password_recover_title" />

                <TextView
                    android:id="@+id/tv_resend_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:onClick="@{() -> viewModel.onResentCodeClicked()}"
                    android:text="@string/tv_resend_code"
                    android:textColor="@drawable/tv_resent_code_blink"
                    app:layout_constraintStart_toStartOf="@id/et_code"
                    app:layout_constraintTop_toBottomOf="@id/tv_password_recover_subtitle" />

                <EditText
                    android:id="@+id/et_code"
                    android:layout_width="280dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:digits="@string/alphanumerics_no_space"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="0dp"
                    android:text="@={viewModel.verificationCode}"
                    android:textColorHint="@color/gray_600"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_resend_code"
                    app:parallelogramBackground="@{R.color.gray_100}"
                    tools:background="@drawable/vw_shape_parallelogram" />

                <Button
                    android:id="@+id/bn_next"
                    android:layout_width="130dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="150dp"
                    android:background="@{ viewModel.nextBnEnabled ? R.color.green_300 : R.color.gray_300 }"
                    android:enabled="@{ viewModel.nextBnEnabled }"
                    android:gravity="center"
                    android:onClick="@{() -> viewModel.onNextClicked()}"
                    android:padding="1dp"
                    android:text="@string/bn_text_next"
                    android:textAllCaps="false"
                    android:textColor="@{ viewModel.nextBnEnabled ? R.color.gray_800 : R.color.gray_500 }"
                    android:textSize="19sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/et_code"
                    tools:background="@drawable/vw_shape_parallelogram" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>