<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.intelab.joblab.presentation.ui.home.main.fragment.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_register_complementary_navigation"
            app:destination="@id/register_complementary_navigation" />
        <deepLink app:uri="joblab://home" />
        <action
            android:id="@+id/action_homeFragment_to_accutest_navigation"
            app:destination="@+id/accutest_navigation" />
        <action
            android:id="@+id/action_homeFragment_to_interests_positions"
            app:destination="@+id/interest_positions_navigation" />
        <action
            android:id="@+id/action_homeFragment_to_notifications"
            app:destination="@+id/notifications_navigation" />
        <action
            android:id="@+id/action_homeFragment_to_profile_navigation"
            app:destination="@id/profile_navigation" />
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <navigation
        android:id="@+id/interest_positions_navigation"
        app:startDestination="@id/interestPositionsFragment">

        <fragment
            android:id="@+id/interestPositionsFragment"
            android:name="com.intelab.joblab.presentation.ui.home.main.fragment.InterestPositionsFragment"
            android:label="fragment_interest_positions"
            tools:layout="@layout/fragment_interes_positions"/>
    </navigation>

    <navigation
        android:id="@+id/notifications_navigation"
        app:startDestination="@id/notificationsFragment">

        <fragment
            android:id="@+id/notificationsFragment"
            android:name="com.intelab.joblab.presentation.ui.home.main.fragment.NotificationsFragment"
            android:label="fragment_notifications"
            tools:layout="@layout/fragment_notifications"/>
    </navigation>

    <navigation
        android:id="@+id/register_complementary_navigation"
        app:startDestination="@id/personalInformationPartTwoFragment">

        <fragment
            android:id="@+id/personalInformationPartTwoFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.PersonalInformationPartTwoFragment"
            android:label="fragment_personal_information_part_two"
            tools:layout="@layout/fragment_personal_information_part_two">
            <action
                android:id="@+id/action_personalInformationPartTwoFragment_to_domicileFragment"
                app:destination="@id/domicileFragment" />
        </fragment>
        <fragment
            android:id="@+id/domicileFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.DomicileFragment"
            android:label="fragment_domicile"
            tools:layout="@layout/fragment_domicile">
            <action
                android:id="@+id/action_domicileFragment_to_creditBureauFragment"
                app:destination="@id/creditBureauFragment" />
            <action
                android:id="@+id/action_domicileFragment_to_personalInformationPartTwoFragment"
                app:destination="@id/personalInformationPartTwoFragment"
                app:popUpTo="@id/domicileFragment"
                app:popUpToInclusive="true" />

        </fragment>
        <fragment
            android:id="@+id/creditBureauFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.CreditBureauFragment"
            android:label="fragment_credit_bureau"
            tools:layout="@layout/fragment_credit_bureau">
            <action
                android:id="@+id/action_creditBureauFragment_to_creditBureauValidateFragment"
                app:destination="@id/creditBureauValidateFragment" />
            <action
                android:id="@+id/action_creditBureauFragment_to_domicileFragment"
                app:destination="@id/domicileFragment"
                app:popUpTo="@id/creditBureauFragment"
                app:popUpToInclusive="true" />

        </fragment>
        <fragment
            android:id="@+id/creditBureauValidateFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.CreditBureauValidateFragment"
            android:label="fragment_credit_bureau_validate"
            tools:layout="@layout/fragment_credit_bureau_validate">
            <action
                android:id="@+id/action_creditBureauValidateFragment_to_lifeStyleFragment"
                app:destination="@id/lifeStyleFragment" />
            <action
                android:id="@+id/action_creditBureauValidateFragment_to_creditBureauFragment"
                app:destination="@id/creditBureauFragment"
                app:popUpTo="@id/creditBureauValidateFragment"
                app:popUpToInclusive="true" />

        </fragment>
        <fragment
            android:id="@+id/lifeStyleFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.LifeStyleFragment"
            android:label="fragment_life_style"
            tools:layout="@layout/fragment_life_style">
            <action
                android:id="@+id/action_lifeStyleFragment_to_lifeStylePartTwoFragment"
                app:destination="@id/lifeStylePartTwoFragment" />
            <action
                android:id="@+id/action_lifeStyleFragment_to_creditBureauValidateFragment"
                app:destination="@id/creditBureauValidateFragment"
                app:popUpTo="@id/lifeStyleFragment"
                app:popUpToInclusive="true" />

        </fragment>
        <fragment
            android:id="@+id/lifeStylePartTwoFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.LifeStylePartTwoFragment"
            android:label="fragment_life_style_part_two"
            tools:layout="@layout/fragment_life_style_part_two">
            <action
                android:id="@+id/action_lifeStylePartTwoFragment_to_economicFragment"
                app:destination="@id/economicFragment" />
            <action
                android:id="@+id/action_lifeStylePartTwoFragment_to_lifeStyleFragment"
                app:destination="@id/lifeStyleFragment"
                app:popUpTo="@id/lifeStylePartTwoFragment"
                app:popUpToInclusive="true" />

        </fragment>
        <fragment
            android:id="@+id/economicFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.EconomicFragment"
            android:label="fragment_economic"
            tools:layout="@layout/fragment_economic">
            <action
                android:id="@+id/action_economicFragment_to_academicFragment"
                app:destination="@id/academicFragment" />
            <action
                android:id="@+id/action_economicFragment_to_lifeStylePartTwoFragment"
                app:destination="@id/lifeStylePartTwoFragment"
                app:popUpTo="@id/economicFragment"
                app:popUpToInclusive="true" />

        </fragment>
        <fragment
            android:id="@+id/academicFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.AcademicFragment"
            android:label="fragment_academic"
            tools:layout="@layout/fragment_academic">
            <action
                android:id="@+id/action_academicFragment_to_jobReferencesFragment"
                app:destination="@id/jobReferencesFragment" />
            <action
                android:id="@+id/action_academicFragment_to_economicFragment"
                app:destination="@id/economicFragment"
                app:popUpTo="@id/academicFragment"
                app:popUpToInclusive="true" />

        </fragment>
        <fragment
            android:id="@+id/jobReferencesFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.JobReferencesFragment"
            android:label="fragment_job_references"
            tools:layout="@layout/fragment_job_references">
            <action
                android:id="@+id/action_jobReferencesFragment_to_socialMediaFragment"
                app:destination="@id/socialMediaFragment" />
            <action
                android:id="@+id/action_jobReferencesFragment_to_previousJobInformationFragment"
                app:destination="@id/previousJobInformationFragment">
                <argument
                    android:name="referenceJobId"
                    android:defaultValue="0"
                    app:argType="integer" />
            </action>
            <action
                android:id="@+id/action_jobReferencesFragment_to_academicFragment"
                app:destination="@id/academicFragment"
                app:popUpTo="@id/jobReferencesFragment"
                app:popUpToInclusive="true" />

        </fragment>
        <fragment
            android:id="@+id/previousJobInformationFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.PreviousJobInformationFragment"
            android:label="fragment_previous_job_information"
            tools:layout="@layout/fragment_previous_job_information">
            <argument
                android:name="referenceJobId"
                android:defaultValue="0"
                app:argType="integer" />
            <argument
                android:name="listOfCompanies"
                app:nullable="false"
                app:argType="string[]" />
        </fragment>
        <fragment
            android:id="@+id/socialMediaFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.SocialMediaFragment"
            android:label="fragment_social_media"
            tools:layout="@layout/fragment_social_media">
            <action
                android:id="@+id/action_socialMediaFragment_to_registerConfirmationFragment"
                app:destination="@id/registerConfirmationFragment" />
            <action
                android:id="@+id/action_socialMediaFragment_to_jobReferencesFragment"
                app:destination="@id/jobReferencesFragment"
                app:popUpTo="@id/socialMediaFragment"
                app:popUpToInclusive="true" />

        </fragment>
        <fragment
            android:id="@+id/registerConfirmationFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.RegisterConfirmationFragment"
            android:label="fragment_register_confirmation"
            tools:layout="@layout/fragment_register_confirmation">

            <action
                android:id="@+id/action_registerConfirmationFragment_to_homeFragment"
                app:destination="@id/homeFragment"
                app:popUpTo="@id/homeFragment"
                app:popUpToInclusive="true" />
            <action
                android:id="@+id/action_registerConfirmationFragment_to_socialMediaFragment"
                app:destination="@id/socialMediaFragment"
                app:popUpTo="@id/registerConfirmationFragment"
                app:popUpToInclusive="true" />

        </fragment>

        <fragment
            android:id="@+id/resumptionFragment"
            android:name="com.intelab.joblab.presentation.ui.home.register.fragment.ResumptionFragment"
            android:label="fragment_resumption"
            tools:layout="@layout/fragment_resumption">

            <action
                android:id="@+id/action_resumptionFragment_to_domicileFragment"
                app:destination="@id/domicileFragment"
                app:popUpTo="@id/resumptionFragment"
                app:popUpToInclusive="true" />

            <action
                android:id="@+id/action_resumptionFragment_to_creditBureauFragment"
                app:destination="@id/creditBureauFragment"
                app:popUpTo="@id/resumptionFragment"
                app:popUpToInclusive="true" />

            <action
                android:id="@+id/action_resumptionFragment_to_creditBureauValidateFragment"
                app:destination="@id/creditBureauValidateFragment"
                app:popUpTo="@id/resumptionFragment"
                app:popUpToInclusive="true" />


            <deepLink app:uri="joblab://resumption" />
            <action
                android:id="@+id/action_resumptionFragment_to_lifeStyleFragment"
                app:destination="@id/lifeStyleFragment"
                app:popUpTo="@id/resumptionFragment"
                app:popUpToInclusive="true" />

            <action
                android:id="@+id/action_resumptionFragment_to_lifeStylePartTwoFragment"
                app:destination="@id/lifeStylePartTwoFragment"
                app:popUpTo="@id/resumptionFragment"
                app:popUpToInclusive="true" />
            <action
                android:id="@+id/action_resumptionFragment_to_economicFragment"
                app:destination="@id/economicFragment"
                app:popUpTo="@id/resumptionFragment"
                app:popUpToInclusive="true" />
            <action
                android:id="@+id/action_resumptionFragment_to_academicFragment"
                app:destination="@id/academicFragment"
                app:popUpTo="@id/resumptionFragment"
                app:popUpToInclusive="true" />
            <action
                android:id="@+id/action_resumptionFragment_to_jobReferencesFragment"
                app:destination="@id/jobReferencesFragment"
                app:popUpTo="@id/resumptionFragment"
                app:popUpToInclusive="true" />
            <action
                android:id="@+id/action_resumptionFragment_to_socialMediaFragment"
                app:destination="@id/socialMediaFragment"
                app:popUpTo="@id/resumptionFragment"
                app:popUpToInclusive="true" />
            <action
                android:id="@+id/action_resumptionFragment_to_registerConfirmationFragment"
                app:destination="@id/registerConfirmationFragment"
                app:popUpTo="@id/resumptionFragment"
                app:popUpToInclusive="true" />
        </fragment>
    </navigation>

    <include app:graph="@navigation/accutest_navigation" />
    <include app:graph="@navigation/profile_navigation" />

</navigation>